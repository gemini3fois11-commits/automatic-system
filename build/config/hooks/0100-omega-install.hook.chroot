#!/bin/bash
# live-build chroot hook — installs OMEGA-TAILS core binaries
set -euo pipefail

BINDIR=/usr/local/bin
LIBDIR=/usr/local/lib/omega-tails

mkdir -p "$LIBDIR"

# Install core scripts as executables
install -m 0755 /usr/local/bin/omega-amnestic-init   "$BINDIR/" 2>/dev/null || true
install -m 0755 /usr/local/bin/omega-amnestic-seal   "$BINDIR/" 2>/dev/null || true
install -m 0755 /usr/local/bin/omega-invariant-gate  "$BINDIR/" 2>/dev/null || true
install -m 0755 /usr/local/bin/omega-void-monitor    "$BINDIR/" 2>/dev/null || true
install -m 0755 /usr/local/bin/omega-status          "$BINDIR/" 2>/dev/null || true

# Enable systemd services
systemctl enable omega-invariant-gate.service 2>/dev/null || true
systemctl enable omega-amnestic.service        2>/dev/null || true
systemctl enable omega-void-monitor.service    2>/dev/null || true

# Harden sysctl
cat >> /etc/sysctl.d/99-omega-tails.conf <<'EOF'
# OMEGA-TAILS hardening
kernel.dmesg_restrict = 1
kernel.kptr_restrict = 2
kernel.yama.ptrace_scope = 3
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
fs.suid_dumpable = 0
vm.swappiness = 0
EOF

echo "[HOOK] omega-tails installed"
