[Unit]
Description=OMEGA-TAILS Amnestic Volatility Layer
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target network.target
ConditionVirtualization=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/omega-amnestic-init
ExecStop=/usr/local/bin/omega-amnestic-seal
TimeoutStopSec=30

[Install]
WantedBy=sysinit.target
